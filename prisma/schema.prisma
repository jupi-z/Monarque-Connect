  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String             @id @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  establishmentId String             @map("establishment_id") @db.Uuid
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  number          String             @db.VarChar(32)
  status          GoodsReceiptStatus @default(DRAFT)
  receivedAt      DateTime           @map("received_at") @db.Timestamptz(6)
  reference       String?            @db.VarChar(160)
  notes           String?            @db.VarChar(5000)
  idempotencyKey  String?            @map("idempotency_key") @db.VarChar(200)
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment   Establishment      @relation(fields: [establishmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines           GoodsReceiptLine[]
  corrections     GoodsReceiptCorrection[]
  correctionLines GoodsReceiptCorrectionLine[]
  inventoryLink   GoodsReceiptInventoryLink?
  inventoryEntries GoodsReceiptInventoryEntry[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, establishmentId, status, receivedAt, id])
  @@index([organizationId, purchaseOrderId, receivedAt, id])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String           @id @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  goodsReceiptId      String           @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId String           @map("purchase_order_line_id") @db.Uuid
  lineIndex           Int              @map("line_index")
  itemId              String?          @map("item_id") @db.Uuid
  itemNameSnapshot    String           @map("item_name_snapshot") @db.VarChar(160)
  unitSnapshot        String           @map("unit_snapshot") @db.VarChar(32)
  quantity            Decimal          @db.Decimal(19, 6)
  goodsReceipt        GoodsReceipt     @relation(fields: [goodsReceiptId, organizationId], references: [id, organizationId], onDelete: Cascade)
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  item                Item?            @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  correctionLines     GoodsReceiptCorrectionLine[]
  inventoryEntries    GoodsReceiptInventoryEntry[]

  @@unique([goodsReceiptId, lineIndex])
  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@unique([id, organizationId])
  @@unique([id, goodsReceiptId, organizationId])
  @@index([organizationId, purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

model GoodsReceiptCorrection {
  id              String                    @id @db.Uuid
  organizationId  String                    @map("organization_id") @db.Uuid
  goodsReceiptId  String                    @map("goods_receipt_id") @db.Uuid
  reason          String                    @db.VarChar(2000)
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid
  idempotencyKey  String?                   @map("idempotency_key") @db.VarChar(200)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  goodsReceipt    GoodsReceipt              @relation(fields: [goodsReceiptId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines           GoodsReceiptCorrectionLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, goodsReceiptId, createdAt, id])
  @@map("goods_receipt_corrections")
}

model GoodsReceiptCorrectionLine {
  id                  String                  @id @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  correctionId        String                  @map("correction_id") @db.Uuid
  goodsReceiptId      String                  @map("goods_receipt_id") @db.Uuid
  goodsReceiptLineId  String                  @map("goods_receipt_line_id") @db.Uuid
  deltaQuantity       Decimal                 @map("delta_quantity") @db.Decimal(19, 6)
  correction          GoodsReceiptCorrection @relation(fields: [correctionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  goodsReceipt        GoodsReceipt            @relation(fields: [goodsReceiptId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goodsReceiptLine    GoodsReceiptLine        @relation(fields: [goodsReceiptLineId, goodsReceiptId, organizationId], references: [id, goodsReceiptId, organizationId], onDelete: Restrict)

  @@unique([correctionId, goodsReceiptLineId])
  @@unique([id, organizationId])
  @@index([organizationId, goodsReceiptLineId])
  @@map("goods_receipt_correction_lines")
}

model GoodsReceiptInventoryLink {
  id                 String                             @id @db.Uuid
  organizationId     String                             @map("organization_id") @db.Uuid
  establishmentId    String                             @map("establishment_id") @db.Uuid
  goodsReceiptId     String                             @map("goods_receipt_id") @db.Uuid
  warehouseId        String?                            @map("warehouse_id") @db.Uuid
  status             GoodsReceiptInventoryLinkStatus   @default(PENDING_ASSIGNMENT)
  sourceRevision     String                             @map("source_revision") @db.VarChar(80)
  decisionSource     GoodsReceiptInventoryDecisionSource @map("decision_source")
  reason             String                             @db.VarChar(2000)
  idempotencyKey     String?                            @map("idempotency_key") @db.VarChar(200)
  assignedByUserId   String?                            @map("assigned_by_user_id") @db.Uuid
  assignedAt         DateTime?                          @map("assigned_at") @db.Timestamptz(6)
  createdAt          DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment      Establishment                      @relation(fields: [establishmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goodsReceipt       GoodsReceipt                       @relation(fields: [goodsReceiptId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouse          Warehouse?                         @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  entries            GoodsReceiptInventoryEntry[]

  @@unique([goodsReceiptId, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, establishmentId, status, createdAt, id])
  @@map("goods_receipt_inventory_links")
}

model GoodsReceiptInventoryEntry {
  id                    String                   @id @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  linkId                String                   @map("link_id") @db.Uuid
  goodsReceiptId        String                   @map("goods_receipt_id") @db.Uuid
  goodsReceiptLineId    String                   @map("goods_receipt_line_id") @db.Uuid
  itemId                String?                  @map("item_id") @db.Uuid
  sourceEventId         String?                  @map("source_event_id") @db.Uuid
  sourceRevision        String                   @map("source_revision") @db.VarChar(80)
  deltaQuantity         Decimal                  @map("delta_quantity") @db.Decimal(19, 6)
  inventoryMovementId   String?                  @unique @map("inventory_movement_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  link                  GoodsReceiptInventoryLink @relation(fields: [linkId, organizationId], references: [id, organizationId], onDelete: Cascade)
  goodsReceipt          GoodsReceipt             @relation(fields: [goodsReceiptId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goodsReceiptLine      GoodsReceiptLine         @relation(fields: [goodsReceiptLineId, goodsReceiptId, organizationId], references: [id, goodsReceiptId, organizationId], onDelete: Restrict)
  item                  Item?                    @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryMovement     InventoryMovement?      @relation(fields: [inventoryMovementId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, goodsReceiptLineId, sourceRevision])
  @@unique([inventoryMovementId, organizationId])
  @@index([organizationId, goodsReceiptId, createdAt, id])
  @@index([organizationId, sourceEventId])
  @@map("goods_receipt_inventory_entries")
}
