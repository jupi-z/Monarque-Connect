model OutboxEvent {
  id                 String                  @id @db.Uuid
  eventType          String                  @map("event_type") @db.VarChar(160)
  eventVersion       Int                     @map("event_version")
  organizationId     String?                 @map("organization_id") @db.Uuid
  establishmentId    String?                 @map("establishment_id") @db.Uuid
  actorType          EventActorType          @map("actor_type")
  actorId            String?                 @map("actor_id") @db.Uuid
  aggregateType      String                  @map("aggregate_type") @db.VarChar(120)
  aggregateId        String                  @map("aggregate_id") @db.Uuid
  correlationId      String                  @map("correlation_id") @db.Uuid
  causationId        String?                 @map("causation_id") @db.Uuid
  requestId          String?                 @map("request_id") @db.VarChar(200)
  dataClassification EventDataClassification @map("data_classification")
  purpose            String                  @db.VarChar(200)
  payloadJson        Json                    @map("payload_json")
  status             OutboxEventStatus       @default(PENDING)
  attempts           Int                     @default(0)
  claimToken         String?                 @map("claim_token") @db.Uuid
  nextAttemptAt      DateTime?               @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt           DateTime?               @map("locked_at") @db.Timestamptz(6)
  lockedBy           String?                 @map("locked_by") @db.VarChar(160)
  processedAt        DateTime?               @map("processed_at") @db.Timestamptz(6)
  lastErrorCode      String?                 @map("last_error_code") @db.VarChar(120)
  lastErrorMessage   String?                 @map("last_error_message") @db.VarChar(1000)
  occurredAt         DateTime                @map("occurred_at") @db.Timestamptz(6)
  recordedAt         DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  receipts           EventConsumerReceipt[]

  @@index([status, nextAttemptAt, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([aggregateType, aggregateId, recordedAt])
  @@index([correlationId])
  @@map("outbox_events")
}

model EventConsumerReceipt {
  id           String      @id @db.Uuid
  consumerName String      @map("consumer_name") @db.VarChar(160)
  eventId      String      @map("event_id") @db.Uuid
  processedAt  DateTime    @default(now()) @map("processed_at") @db.Timestamptz(6)
  event        OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([consumerName, eventId])
  @@index([eventId])
  @@map("event_consumer_receipts")
}

model FoundationProbe {
  id        String   @id @db.Uuid
  value     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("foundation_probes")
}

model FoundationProbeProjection {
  id        String   @id @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  value     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("foundation_probe_projections")
}

model User {
  id              String           @id @db.Uuid
  email           String           @db.VarChar(320)
  normalizedEmail String           @unique @map("normalized_email") @db.VarChar(320)
  phone           String?          @db.VarChar(40)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  firstName       String           @map("first_name") @db.VarChar(100)
  lastName        String           @map("last_name") @db.VarChar(100)
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     Membership[]
  refreshSessions RefreshSession[]
  createdExpenses Expense[]
  createdCashAccounts CashAccount[]
  createdCashMovements CashMovement[]

  @@index([status])
  @@map("users")
}

model RefreshSession {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model LoginRateLimitBucket {
  keyHash       String    @id @map("key_hash") @db.VarChar(128)
  failures      Int       @default(0)
  blockedUntil  DateTime? @map("blocked_until") @db.Timestamptz(6)
  windowStarted DateTime  @map("window_started") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("login_rate_limit_buckets")
}

model BusinessType {
  code          String                     @id @db.VarChar(64)
  name          String                     @db.VarChar(160)
  description   String?                    @db.VarChar(500)
  active        Boolean                    @default(true)
  sortOrder     Int                        @default(0) @map("sort_order")
  organizations Organization[]
  modulePresets ModuleBusinessTypePreset[]

  @@index([active, sortOrder])
  @@map("business_types")
}

model ModuleCatalog {
  code                     String                         @id @db.VarChar(64)
  displayName              String                         @map("display_name") @db.VarChar(160)
  pillar                   String                         @db.VarChar(80)
  description              String?                        @db.VarChar(500)
  availability             ModuleAvailability             @default(MVP)
  isCore                   Boolean                        @default(false) @map("is_core")
  dependenciesJson         Json                           @default("[]") @map("dependencies_json")
  clientMetadataJson       Json                           @default("{}") @map("client_metadata_json")
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  planModules              PlanVersionModule[]
  organizationActivations  OrganizationModuleActivation[]
  businessTypePresets      ModuleBusinessTypePreset[]
  organizationEntitlements OrganizationEntitlement[]

  @@index([availability, isCore])
  @@map("module_catalog")
}

model Plan {
  code           String        @id @db.VarChar(64)
  name           String        @db.VarChar(160)
  description    String?       @db.VarChar(500)
  managedService Boolean       @default(false) @map("managed_service")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  versions       PlanVersion[]

  @@map("plans")
}

model PlanVersion {
  id            String              @id @db.Uuid
  planCode      String              @map("plan_code") @db.VarChar(64)
  version       Int
  status        PlanVersionStatus
  currency      String              @db.Char(3)
  billingPeriod BillingPeriod       @map("billing_period")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz(6)
  plan          Plan                @relation(fields: [planCode], references: [code])
  modules       PlanVersionModule[]
  quotas        PlanVersionQuota[]
  subscriptions Subscription[]

  @@unique([planCode, version])
  @@index([planCode, status])
  @@map("plan_versions")
}

model PlanVersionModule {
  planVersionId         String        @map("plan_version_id") @db.Uuid
  moduleCode            String        @map("module_code") @db.VarChar(64)
  defaultEnabled        Boolean       @default(true) @map("default_enabled")
  entitlementConfigJson Json          @default("{}") @map("entitlement_config_json")
  planVersion           PlanVersion   @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  module                ModuleCatalog @relation(fields: [moduleCode], references: [code])

  @@id([planVersionId, moduleCode])
  @@index([moduleCode])
  @@map("plan_version_modules")
}

model PlanVersionQuota {
  id            String      @id @db.Uuid
  planVersionId String      @map("plan_version_id") @db.Uuid
  quotaCode     String      @map("quota_code") @db.VarChar(80)
  unit          QuotaUnit
  mode          QuotaMode   @default(PERIODIC)
  limitValue    BigInt      @map("limit_value")
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, quotaCode])
  @@map("plan_version_quotas")
}

model Organization {
  id                String                         @id @db.Uuid
  businessTypeCode  String                         @map("business_type_code") @db.VarChar(64)
  name              String                         @db.VarChar(160)
  legalName         String?                        @map("legal_name") @db.VarChar(200)
  handle            String                         @unique @db.VarChar(50)
  defaultCurrency   String                         @map("default_currency") @db.Char(3)
  status            OrganizationStatus             @default(ACTIVE)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessType      BusinessType                   @relation(fields: [businessTypeCode], references: [code])
  establishments    Establishment[]
  memberships       Membership[]
  invitations       Invitation[]
  auditEvents       AuditEvent[]
  subscriptions     Subscription[]
  moduleActivations OrganizationModuleActivation[]
  quotaUsages       OrganizationQuotaUsage[]
  quotaReservations QuotaReservation[]
  quotaLedgers      QuotaLedger[]
  entitlements      OrganizationEntitlement[]
  businessParties   BusinessParty[]
  items             Item[]
  warehouses        Warehouse[]
  leads             Lead[]
  opportunities     Opportunity[]
  networkProfile     OrganizationNetworkProfile?
  networkTrust       OrganizationNetworkTrust?
  connectionRequestsSent     ConnectionRequest[] @relation("ConnectionRequestsSent")
  connectionRequestsReceived ConnectionRequest[] @relation("ConnectionRequestsReceived")
  networkInquiriesSent       NetworkInquiry[] @relation("NetworkInquiriesSent")
  networkInquiriesReceived   NetworkInquiry[] @relation("NetworkInquiriesReceived")
  salesNumberCounters        SalesNumberCounter[]
  quotes                     Quote[]
  salesOrders                SalesOrder[]
  invoices                   Invoice[]
  paymentRecords             PaymentRecord[]
  supplierRfqs               SupplierRFQ[]
  purchaseOrders             PurchaseOrder[]
  goodsReceipts              GoodsReceipt[]
  goodsReceiptInventoryLinks GoodsReceiptInventoryLink[]
  goodsReceiptInventoryEntries GoodsReceiptInventoryEntry[]
  inventoryMovements         InventoryMovement[]
  inventoryBalances          InventoryBalance[]
  inventoryReconciliations   InventoryReconciliation[]
  expenses                   Expense[]
  expenseIdempotencyKeys     ExpenseIdempotencyKey[]
  cashAccounts               CashAccount[]
  cashMovements              CashMovement[]
  cashAccountIdempotencyKeys CashAccountIdempotencyKey[]
  cashMovementIdempotencyKeys CashMovementIdempotencyKey[]
  purchaseIdempotencyKeys    PurchaseIdempotencyKey[]
  networkSupplierRfqRecipients SupplierRFQRecipient[] @relation("NetworkSupplierRFQRecipients")
  purchaseOrdersAsNetworkSupplier PurchaseOrder[] @relation("PurchaseOrderSupplierOrganization")

  @@index([businessTypeCode])
  @@index([status])
  @@map("organizations")
}

model OrganizationNetworkProfile {
  id               String       @id @db.Uuid
  organizationId   String       @unique @map("organization_id") @db.Uuid
  isPublic         Boolean      @default(false) @map("is_public")
  displayName      String       @map("display_name") @db.VarChar(160)
  description      String?      @db.VarChar(2000)
  categories       Json         @default("[]")
  publicLocation   String?      @map("public_location") @db.VarChar(160)
  publishedItemIds Json         @default("[]") @map("published_item_ids")
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_network_profiles")
}

model OrganizationNetworkTrust {
  id                    String                   @id @db.Uuid
  organizationId        String                   @unique @map("organization_id") @db.Uuid
  verificationStatus    NetworkVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt            DateTime?                @map("verified_at") @db.Timestamptz(6)
  verificationExpiresAt DateTime?                @map("verification_expires_at") @db.Timestamptz(6)
  publishedCredentials  Json                     @default("[]") @map("published_credentials")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_network_trust")
}

model ConnectionRequest {
  id                   String                  @id @db.Uuid
  sourceOrganizationId String                  @map("source_organization_id") @db.Uuid
  targetOrganizationId String                  @map("target_organization_id") @db.Uuid
  status               ConnectionRequestStatus @default(PENDING)
  message              String?                 @db.VarChar(2000)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceOrganization   Organization            @relation("ConnectionRequestsSent", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)
  targetOrganization   Organization            @relation("ConnectionRequestsReceived", fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([sourceOrganizationId, status, createdAt, id])
  @@index([targetOrganizationId, status, createdAt, id])
  @@map("connection_requests")
}

model Subscription {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  planVersionId  String             @map("plan_version_id") @db.Uuid
  status         SubscriptionStatus
  startsAt       DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz(6)
  canceledAt     DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planVersion    PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, startsAt, endsAt])
  @@index([planVersionId])
  @@map("subscriptions")
}

model OrganizationModuleActivation {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  moduleCode     String        @map("module_code") @db.VarChar(64)
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         ModuleCatalog @relation(fields: [moduleCode], references: [code], onDelete: Restrict)

  @@unique([organizationId, moduleCode])
  @@index([organizationId, enabled])
  @@map("organization_module_activations")
}

model ModuleBusinessTypePreset {
  businessTypeCode String        @map("business_type_code") @db.VarChar(64)
  moduleCode       String        @map("module_code") @db.VarChar(64)
  recommended      Boolean       @default(true)
  defaultEnabled   Boolean       @default(true) @map("default_enabled")
  businessType     BusinessType  @relation(fields: [businessTypeCode], references: [code], onDelete: Cascade)
  module           ModuleCatalog @relation(fields: [moduleCode], references: [code], onDelete: Cascade)

  @@id([businessTypeCode, moduleCode])
  @@index([moduleCode])
  @@map("module_business_type_presets")
}

model OrganizationEntitlement {
  id             String            @id @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  moduleCode     String            @map("module_code") @db.VarChar(64)
  effect         EntitlementEffect
  startsAt       DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?         @map("ends_at") @db.Timestamptz(6)
  reason         String            @db.VarChar(500)
  limitsJson     Json              @default("{}") @map("limits_json")
  createdByActor String            @map("created_by_actor") @db.VarChar(160)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         ModuleCatalog     @relation(fields: [moduleCode], references: [code], onDelete: Restrict)

  @@index([organizationId, moduleCode, startsAt, endsAt])
  @@index([organizationId, effect, startsAt, endsAt])
  @@map("organization_entitlements")
}

model OrganizationQuotaUsage {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  quotaCode      String             @map("quota_code") @db.VarChar(80)
  periodKey      String             @map("period_key") @db.VarChar(32)
  limitValue     BigInt             @map("limit_value")
  usedValue      BigInt             @default(0) @map("used_value")
