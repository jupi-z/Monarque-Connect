  targetOrganization   Organization              @relation("MessagingInvitationTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  targetUser           User?                     @relation("MessagingInvitationTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdByUser        User                      @relation("MessagingInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([targetOrganizationId, type, status, expiresAt])
  @@index([targetUserId, type, status, expiresAt])
  @@index([conversationId, type, status])
  @@map("messaging_invitations")
}

model Message {
  id                   String       @id @db.Uuid
  conversationId       String       @map("conversation_id") @db.Uuid
  sequence             BigInt
  authorUserId         String       @map("author_user_id") @db.Uuid
  sourceOrganizationId String       @map("source_organization_id") @db.Uuid
  clientMessageId      String       @map("client_message_id") @db.VarChar(128)
  body                 String       @db.VarChar(10000)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  authorUser           User         @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  sourceOrganization   Organization @relation("MessageSourceOrganization", fields: [sourceOrganizationId], references: [id], onDelete: Restrict)

  @@unique([conversationId, sequence])
  @@unique([conversationId, authorUserId, clientMessageId])
  @@index([conversationId, sequence])
  @@index([sourceOrganizationId, createdAt])
  @@map("messages")
}

model MessagingOrganizationBlock {
  id                   String       @id @db.Uuid
  sourceOrganizationId String       @map("source_organization_id") @db.Uuid
  targetOrganizationId String       @map("target_organization_id") @db.Uuid
  createdByUserId      String       @map("created_by_user_id") @db.Uuid
  reason               String?      @db.VarChar(500)
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(6)
  sourceOrganization   Organization @relation("MessagingBlockSourceOrganization", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)
  targetOrganization   Organization @relation("MessagingBlockTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  createdByUser        User         @relation("MessagingBlockCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([sourceOrganizationId, targetOrganizationId])
  @@index([targetOrganizationId, active])
  @@map("messaging_organization_blocks")
}

model MessagingRateBucket {
  id                     String                           @id @db.Uuid
  organizationId         String?                          @map("organization_id") @db.Uuid
  conversationId         String?                          @map("conversation_id") @db.Uuid
  dimension              String                           @db.VarChar(32)
  dimensionKeyHash       String                           @map("dimension_key_hash") @db.VarChar(128)
  windowStarted          DateTime                         @map("window_started") @db.Timestamptz(6)
  windowEnds             DateTime                         @map("window_ends") @db.Timestamptz(6)
  attemptCount           Int                              @default(0) @map("attempt_count")
  acceptedCount          Int                              @default(0) @map("accepted_count")
  rejectedCount          Int                              @default(0) @map("rejected_count")
  blockedUntil           DateTime?                        @map("blocked_until") @db.Timestamptz(6)
  contentFingerprintHmac String?                          @map("content_fingerprint_hmac") @db.VarChar(128)
  fingerprintCount       Int                              @default(0) @map("fingerprint_count")
  createdAt              DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization?                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation           Conversation?                    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fingerprints           MessagingRateBucketFingerprint[]

  @@unique([dimension, dimensionKeyHash, windowStarted])
  @@index([organizationId, windowEnds])
  @@index([conversationId, windowEnds])
  @@map("messaging_rate_buckets")
}

model MessagingRateBucketFingerprint {
  id              String              @id @db.Uuid
  rateBucketId    String              @map("rate_bucket_id") @db.Uuid
  fingerprintHmac String              @map("fingerprint_hmac") @db.VarChar(128)
  attemptCount    Int                 @default(0) @map("attempt_count")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  rateBucket      MessagingRateBucket @relation(fields: [rateBucketId], references: [id], onDelete: Cascade)

  @@unique([rateBucketId, fingerprintHmac])
  @@index([fingerprintHmac, updatedAt])
  @@map("messaging_rate_bucket_fingerprints")
}

model MessagingCommandReceipt {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  operation      String       @db.VarChar(80)
  idempotencyKey String       @map("idempotency_key") @db.VarChar(200)
  payloadHash    String       @map("payload_hash") @db.VarChar(128)
  resourceType   String       @map("resource_type") @db.VarChar(80)
  resourceId     String       @map("resource_id") @db.Uuid
  responseJson   Json         @map("response_json")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, actorUserId, operation, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("messaging_command_receipts")
}

model NetworkTrustCommandReceipt {
  id                    String                    @id @db.Uuid
  organizationId        String                    @map("organization_id") @db.Uuid
  actorUserId           String                    @map("actor_user_id") @db.Uuid
  idempotencyKey        String                    @map("idempotency_key") @db.VarChar(200)
  payloadHash           String                    @map("payload_hash") @db.VarChar(128)
  verificationStatus    NetworkVerificationStatus @map("verification_status")
  verifiedAt            DateTime?                 @map("verified_at") @db.Timestamptz(6)
  verificationExpiresAt DateTime?                 @map("verification_expires_at") @db.Timestamptz(6)
  reason                String                    @db.VarChar(500)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser             User                      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, actorUserId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("network_trust_command_receipts")
}
