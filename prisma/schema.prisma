model OutboxEvent {
  id                 String                  @id @db.Uuid
  eventType          String                  @map("event_type") @db.VarChar(160)
  eventVersion       Int                     @map("event_version")
  organizationId     String?                 @map("organization_id") @db.Uuid
  establishmentId    String?                 @map("establishment_id") @db.Uuid
  actorType          EventActorType          @map("actor_type")
  actorId            String?                 @map("actor_id") @db.Uuid
  aggregateType      String                  @map("aggregate_type") @db.VarChar(120)
  aggregateId        String                  @map("aggregate_id") @db.Uuid
  correlationId      String                  @map("correlation_id") @db.Uuid
  causationId        String?                 @map("causation_id") @db.Uuid
  requestId          String?                 @map("request_id") @db.VarChar(200)
  dataClassification EventDataClassification @map("data_classification")
  purpose            String                  @db.VarChar(200)
  payloadJson        Json                    @map("payload_json")
  status             OutboxEventStatus       @default(PENDING)
  attempts           Int                     @default(0)
  claimToken         String?                 @map("claim_token") @db.Uuid
  nextAttemptAt      DateTime?               @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt           DateTime?               @map("locked_at") @db.Timestamptz(6)
  lockedBy           String?                 @map("locked_by") @db.VarChar(160)
  processedAt        DateTime?               @map("processed_at") @db.Timestamptz(6)
  lastErrorCode      String?                 @map("last_error_code") @db.VarChar(120)
  lastErrorMessage   String?                 @map("last_error_message") @db.VarChar(1000)
  occurredAt         DateTime                @map("occurred_at") @db.Timestamptz(6)
  recordedAt         DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  receipts           EventConsumerReceipt[]

  @@index([status, nextAttemptAt, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([aggregateType, aggregateId, recordedAt])
  @@index([correlationId])
  @@map("outbox_events")
}

model EventConsumerReceipt {
  id           String      @id @db.Uuid
  consumerName String      @map("consumer_name") @db.VarChar(160)
  eventId      String      @map("event_id") @db.Uuid
  processedAt  DateTime    @default(now()) @map("processed_at") @db.Timestamptz(6)
  event        OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([consumerName, eventId])
  @@index([eventId])
  @@map("event_consumer_receipts")
}

model FoundationProbe {
  id        String   @id @db.Uuid
  value     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("foundation_probes")
}

model FoundationProbeProjection {
  id        String   @id @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  value     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("foundation_probe_projections")
}

model User {
  id                                String                                @id @db.Uuid
  email                             String                                @db.VarChar(320)
  normalizedEmail                   String                                @unique @map("normalized_email") @db.VarChar(320)
  phone                             String?                               @db.VarChar(40)
  passwordHash                      String                                @map("password_hash") @db.VarChar(255)
  firstName                         String                                @map("first_name") @db.VarChar(100)
  lastName                          String                                @map("last_name") @db.VarChar(100)
  status                            UserStatus                            @default(ACTIVE)
  createdAt                         DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                       Membership[]
  refreshSessions                   RefreshSession[]
  createdExpenses                   Expense[]
  createdCashAccounts               CashAccount[]
  createdCashMovements              CashMovement[]
  createdMessagingConversations     Conversation[]                        @relation("MessagingConversationCreatedBy")
  messagingOrganizationParticipants ConversationOrganizationParticipant[] @relation("MessagingOrganizationParticipantCreatedBy")
  messagingUserParticipants         ConversationUserParticipant[]         @relation("MessagingUserParticipantUser")
  authoredMessages                  Message[]                             @relation("MessageAuthor")
  createdMessagingInvitations       MessagingInvitation[]                 @relation("MessagingInvitationCreatedBy")
  targetedMessagingInvitations      MessagingInvitation[]                 @relation("MessagingInvitationTargetUser")
  createdMessagingBlocks            MessagingOrganizationBlock[]          @relation("MessagingBlockCreatedBy")
  networkTrustCommandReceipts       NetworkTrustCommandReceipt[]
  messagingCommandReceipts          MessagingCommandReceipt[]

  @@index([status])
  @@map("users")
}

model RefreshSession {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model LoginRateLimitBucket {
  keyHash       String    @id @map("key_hash") @db.VarChar(128)
  failures      Int       @default(0)
  blockedUntil  DateTime? @map("blocked_until") @db.Timestamptz(6)
  windowStarted DateTime  @map("window_started") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("login_rate_limit_buckets")
}

model BusinessType {
  code          String                     @id @db.VarChar(64)
  name          String                     @db.VarChar(160)
  description   String?                    @db.VarChar(500)
  active        Boolean                    @default(true)
  sortOrder     Int                        @default(0) @map("sort_order")
  organizations Organization[]
  modulePresets ModuleBusinessTypePreset[]

  @@index([active, sortOrder])
  @@map("business_types")
}

model ModuleCatalog {
  code                     String                         @id @db.VarChar(64)
  displayName              String                         @map("display_name") @db.VarChar(160)
  pillar                   String                         @db.VarChar(80)
  description              String?                        @db.VarChar(500)
  availability             ModuleAvailability             @default(MVP)
  isCore                   Boolean                        @default(false) @map("is_core")
  dependenciesJson         Json                           @default("[]") @map("dependencies_json")
  clientMetadataJson       Json                           @default("{}") @map("client_metadata_json")
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  planModules              PlanVersionModule[]
  organizationActivations  OrganizationModuleActivation[]
  businessTypePresets      ModuleBusinessTypePreset[]
  organizationEntitlements OrganizationEntitlement[]

  @@index([availability, isCore])
  @@map("module_catalog")
}

model Plan {
  code           String         @id @db.VarChar(64)
  name           String         @db.VarChar(160)
  description    String?        @db.VarChar(500)
  managedService Boolean        @default(false) @map("managed_service")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  versions       PlanVersion[]
  priceVersions  PriceVersion[]

  @@map("plans")
}

model PlanVersion {
  id            String              @id @db.Uuid
  planCode      String              @map("plan_code") @db.VarChar(64)
  version       Int
  status        PlanVersionStatus
  currency      String              @db.Char(3)
  billingPeriod BillingPeriod       @map("billing_period")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz(6)
  plan          Plan                @relation(fields: [planCode], references: [code])
  modules       PlanVersionModule[]
  quotas        PlanVersionQuota[]
  subscriptions Subscription[]

  @@unique([planCode, version])
  @@index([planCode, status])
  @@map("plan_versions")
}

model PlanVersionModule {
  planVersionId         String        @map("plan_version_id") @db.Uuid
  moduleCode            String        @map("module_code") @db.VarChar(64)
  defaultEnabled        Boolean       @default(true) @map("default_enabled")
  entitlementConfigJson Json          @default("{}") @map("entitlement_config_json")
  planVersion           PlanVersion   @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  module                ModuleCatalog @relation(fields: [moduleCode], references: [code])

  @@id([planVersionId, moduleCode])
  @@index([moduleCode])
  @@map("plan_version_modules")
}

model PlanVersionQuota {
  id            String      @id @db.Uuid
  planVersionId String      @map("plan_version_id") @db.Uuid
  quotaCode     String      @map("quota_code") @db.VarChar(80)
  unit          QuotaUnit
  mode          QuotaMode   @default(PERIODIC)
  limitValue    BigInt      @map("limit_value")
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, quotaCode])
  @@map("plan_version_quotas")
}

model PriceVersion {
  id                        String             @id @db.Uuid
  planCode                  String             @map("plan_code") @db.VarChar(64)
  version                   Int
  billingPeriod             BillingPeriod      @map("billing_period")
  currency                  String             @db.Char(3)
  status                    PriceVersionStatus
  baseAmountMinor           BigInt             @map("base_amount_minor")
  welcomeAmountMinor        BigInt             @map("welcome_amount_minor")
  annualDiscountAmountMinor BigInt             @default(0) @map("annual_discount_amount_minor")
  includedEstablishments    Int                @map("included_establishments")
  startsAt                  DateTime           @map("starts_at") @db.Timestamptz(6)
  publishedAt               DateTime?          @map("published_at") @db.Timestamptz(6)
  retiredAt                 DateTime?          @map("retired_at") @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  plan                      Plan               @relation(fields: [planCode], references: [code], onDelete: Restrict)
  components                PriceComponent[]
  quotes                    BillingQuote[]

  @@unique([planCode, version, billingPeriod])
  @@index([planCode, status, billingPeriod, startsAt])
  @@map("price_versions")
}

model PriceComponent {
  id             String             @id @db.Uuid
  priceVersionId String             @map("price_version_id") @db.Uuid
  code           String             @db.VarChar(64)
  kind           PriceComponentKind
  currency       String             @db.Char(3)
  amountMinor    BigInt             @map("amount_minor")
  capacityUnits  Int                @map("capacity_units")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  priceVersion   PriceVersion       @relation(fields: [priceVersionId], references: [id], onDelete: Cascade)

  @@unique([priceVersionId, code])
  @@index([code, kind])
  @@map("price_components")
}

model BillingCustomer {
  id                   String                        @id @db.Uuid
  identityKey          String?                       @unique @map("identity_key") @db.VarChar(200)
  displayName          String                        @map("display_name") @db.VarChar(200)
  status               BillingCustomerStatus         @default(UNVERIFIED)
  verifiedAt           DateTime?                     @map("verified_at") @db.Timestamptz(6)
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations        BillingCustomerOrganization[]
  quotes               BillingQuote[]
  promotionRedemptions BillingPromotionRedemption[]
  promotionEligibility BillingPromotionEligibility[]
  subscriptionTerms    BillingSubscriptionTerm[]
  checkoutOrders       BillingCheckoutOrder[]
  invoices             BillingInvoice[]
  paymentAttempts      BillingPaymentAttempt[]
  payments             BillingPayment[]
  providerEvents       BillingProviderEventInbox[]

  @@index([status, createdAt])
  @@map("billing_customers")
}

model BillingCustomerOrganization {
  billingCustomerId String                          @map("billing_customer_id") @db.Uuid
  organizationId    String                          @map("organization_id") @db.Uuid
  role              BillingCustomerOrganizationRole @default(OWNER)
  evidenceJson      Json                            @default("{}") @map("evidence_json")
  verifiedAt        DateTime?                       @map("verified_at") @db.Timestamptz(6)
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  billingCustomer   BillingCustomer                 @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([billingCustomerId, organizationId])
  @@index([organizationId])
  @@map("billing_customer_organizations")
}

model BillingQuote {
  id                       String                       @id @db.Uuid
  organizationId           String                       @map("organization_id") @db.Uuid
  billingCustomerId        String                       @map("billing_customer_id") @db.Uuid
  priceVersionId           String                       @map("price_version_id") @db.Uuid
  idempotencyKey           String                       @map("idempotency_key") @db.VarChar(200)
  status                   BillingQuoteStatus
  planCode                 String                       @map("plan_code") @db.VarChar(64)
